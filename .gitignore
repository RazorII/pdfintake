# Virtual environments
.venv/
.venv-*/
venv/
env/

# Python caches and build output
__pycache__/
*.py[cod]
/build/
/dist/
*.egg-info/
.eggs/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

