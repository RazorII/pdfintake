{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RazorII/pdfintake/blob/main/src/pdfintake/langpacks/manifest.schema.json",
  "title": "pdfintake language pack manifest, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "requires_core", "title", "languages", "scripts",
               "detect", "readers", "normalize", "repairs", "fills", "models", "fonts", "must_survive", "bench"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})?$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "requires_core": {"type": "string", "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "base": {"type": "boolean"},
    "title": {"type": "string", "pattern": "^[A-Z][A-Za-z ()-]{0,39}$"},
    "languages": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/language"}},
    "scripts": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "detect": {"$ref": "#/$defs/detect"},
    "readers": {"type": "object", "required": ["default"], "maxProperties": 8,
                "propertyNames": {"pattern": "^(default|[a-z]+-[a-z0-9_]+)$"},
                "additionalProperties": {"$ref": "#/$defs/readerSet"}},
    "normalize": {"type": "array", "uniqueItems": true, "maxItems": 8, "items": {"$ref": "#/$defs/name"}},
    "repairs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/step"}},
    "fills": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/step"}},
    "models": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/model"}},
    "fonts": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/font"}},
    "canary": {"$ref": "#/$defs/canary"},
    "must_survive": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/mustSurvive"}},
    "bench": {"$ref": "#/$defs/bench"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"},
    "useId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
    "assetKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,40}$"},
    "assetRef": {"type": "string", "pattern": "^(en:)?[a-z0-9][a-z0-9_.-]{0,40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "noCodeSuffix": {"type": "string", "pattern": "^(?!.*\\.([Pp][Yy][Dd]?|[Pp][Tt][Hh]|[Ss][Oo]|[Dd][Yy][Ll][Ii][Bb]|[Dd][Ll][Ll])$)"},
    "language": {"type": "object", "additionalProperties": false, "required": ["tag", "iso639_3", "role"],
      "properties": {"tag": {"type": "string", "pattern": "^[a-z]{2,3}$"},
                     "iso639_3": {"type": "string", "pattern": "^[a-z]{3}$"},
                     "role": {"enum": ["primary", "secondary"]}}},
    "params": {"type": "object", "maxProperties": 16,
               "additionalProperties": {"type": ["string", "number", "boolean", "array", "object"]}},
    "engineUse": {"type": "object", "additionalProperties": false, "required": ["id", "engine", "role", "params", "models"],
      "properties": {"id": {"$ref": "#/$defs/useId"}, "engine": {"$ref": "#/$defs/name"},
                     "role": {"enum": ["reader", "checker", "probe"]}, "params": {"$ref": "#/$defs/params"},
                     "models": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/assetRef"}}}},
    "ruleUse": {"type": "object", "additionalProperties": false, "required": ["rule", "version", "params"],
      "properties": {"rule": {"$ref": "#/$defs/name"}, "version": {"type": "integer", "minimum": 1, "maximum": 99},
                     "params": {"$ref": "#/$defs/params"}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "version": {"type": "integer", "minimum": 1, "maximum": 99},
                     "params": {"$ref": "#/$defs/params"}}},
    "readerSet": {"type": "object", "additionalProperties": false, "required": ["engines", "pick", "fallback"],
      "properties": {"engines": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/engineUse"}},
                     "pick": {"$ref": "#/$defs/ruleUse"},
                     "fallback": {"enum": ["checker", "none"]}}},
    "detect": {"type": "object", "additionalProperties": false, "required": ["osd_scripts"],
      "properties": {
        "osd_scripts": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/name"}},
        "langid": {"type": "object", "additionalProperties": false, "required": ["codes"],
          "properties": {"codes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}},
                         "close_group": {"type": "array", "maxItems": 6, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}}}},
        "function_words": {"type": "object", "additionalProperties": false, "required": ["words"],
          "properties": {"words": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 24}},
                         "rivals": {"type": "array", "maxItems": 400, "items": {"type": "string", "minLength": 1, "maxLength": 24}},
                         "min_hits": {"type": "integer", "minimum": 1, "maximum": 20},
                         "ratio": {"type": "number", "minimum": 0, "maximum": 1}}},
        "probe": {"type": "object", "additionalProperties": false, "required": ["use", "min_chars", "min_conf"],
          "properties": {"use": {"$ref": "#/$defs/engineUse"},
                         "min_chars": {"type": "integer", "minimum": 1, "maximum": 1000},
                         "min_conf": {"type": "number", "minimum": 0, "maximum": 1},
                         "min_line_chars": {"type": "integer", "minimum": 1, "maximum": 50}}}}},
    "model": {"type": "object", "additionalProperties": false,
      "required": ["key", "file", "engine", "kind", "bytes", "sha256", "source", "licence"],
      "properties": {"key": {"$ref": "#/$defs/assetKey"},
                     "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,80}$", "$ref": "#/$defs/noCodeSuffix"},
                     "engine": {"$ref": "#/$defs/name"},
                     "kind": {"enum": ["traineddata", "onnx_det", "onnx_cls", "onnx_rec", "rec_keys"]},
                     "bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
                     "sha256": {"$ref": "#/$defs/sha256"},
                     "source": {"type": "string", "maxLength": 300,
                       "pattern": "^https://(github\\.com/tesseract-ocr/tessdata(_best|_fast)?/raw/[0-9a-f]{40}/[A-Za-z0-9_.+-]+|github\\.com/RapidAI/[A-Za-z0-9_.-]+/(raw/[0-9a-f]{40}|releases/download/[A-Za-z0-9_.+-]+)/[A-Za-z0-9_/.+-]+|www\\.modelscope\\.cn/models/RapidAI/RapidOCR/resolve/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9_/.+-]+)$"},
                     "licence": {"enum": ["Apache-2.0", "BSD-3-Clause", "MIT", "CC0-1.0"]},
                     "notice": {"type": "string", "pattern": "^NOTICE-[a-z0-9-]{1,30}$"}}},
    "font": {"type": "object", "additionalProperties": false,
      "required": ["key", "file", "covers", "bytes", "sha256", "source", "licence"],
      "properties": {"key": {"$ref": "#/$defs/assetKey"},
                     "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,80}\\.(ttf|otf)$"},
                     "covers": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/name"}},
                     "bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
                     "sha256": {"$ref": "#/$defs/sha256"},
                     "source": {"type": "string", "maxLength": 300,
                       "pattern": "^https://github\\.com/notofonts/[A-Za-z0-9_.-]+/(raw/[0-9a-f]{40}|releases/download/[A-Za-z0-9_.+-]+)/[A-Za-z0-9_/.+-]+$"},
                     "licence": {"enum": ["OFL-1.1"]}}},
    "canary": {"type": "object", "additionalProperties": false, "required": ["file", "bytes", "sha256", "dpi", "must_find"],
      "properties": {"file": {"type": "string", "pattern": "^canary-[a-z0-9-]{1,20}\\.png$"},
                     "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
                     "sha256": {"$ref": "#/$defs/sha256"},
                     "dpi": {"type": "integer", "minimum": 150, "maximum": 400},
                     "must_find": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S"}}}},
    "mustSurvive": {"type": "object", "additionalProperties": false, "required": ["name", "chars", "unit", "floor"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
                     "chars": {"type": "string", "minLength": 1, "maxLength": 64},
                     "unit": {"enum": ["word", "trigram", "char"]},
                     "floor": {"type": "number", "minimum": 0, "maximum": 1}}},
    "triple": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "bench": {"type": "object", "additionalProperties": false, "required": ["kit", "corpus", "platforms"],
      "properties": {"kit": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
                     "corpus": {"type": "string", "pattern": "^([a-z0-9-]+@[0-9a-f]{64}|none)$"},
                     "engine_versions": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 60}},
                     "platforms": {"type": "object", "maxProperties": 8,
                       "additionalProperties": {"type": "object", "additionalProperties": false,
                         "required": ["metrics", "worst_page", "seconds_per_page", "selection"],
                         "properties": {"metrics": {"type": "object", "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/triple"}},
                                        "worst_page": {"type": "number", "minimum": 0, "maximum": 1},
                                        "seconds_per_page": {"type": "number", "minimum": 0},
                                        "selection": {"type": "object", "additionalProperties": false, "required": ["policy", "margin"],
                                          "properties": {"policy": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                                                         "margin": {"type": "number"},
                                                         "override_reason": {"type": "string", "maxLength": 300}}}}}},
                     "private": {"type": "object", "additionalProperties": false, "required": ["pages", "metrics"],
                       "properties": {"pages": {"type": "integer", "minimum": 1},
                                      "metrics": {"type": "object", "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/triple"}}}}}}
  }
}
